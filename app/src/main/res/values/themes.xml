<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ZMusic" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>

        <item name="android:navigationBarColor">#80000000</item>
        <!-- 窗口基础态声明白图标（参考项目同款）：
             Android 16 (targetSdk 36+) 强制 edge-to-edge 且无法退出，系统会在
             动画结束/重布局等时刻按主题声明的 windowLightStatusBar 重新着色状态栏图标。
             声明 false（白图标）后，系统的重新取色永远落在白——与经典播放页想要的一致；
             主屏黑图标由 App 在运行时用 WindowInsetsControllerCompat 写入（官方文档认可方式）。 -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/startup_bg_light</item>
    </style>
</resources>
